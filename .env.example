POSTGRES_USER=cyberadmin
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=cyberintel
# Master API Key for Live Mode DAST Scans (Required for active scans on production)
# Choose a strong, random password.
ADMIN_API_KEY=minha-super-chave-mestra-secreta

# Frontend now proxies API calls through Next.js, so no public API URL is required.
# Keep custom backend overrides in compose only if you really need them.
# Optional when running NEXT dev behind a public droplet IP.
# Example: NEXT_ALLOWED_DEV_ORIGINS=http://YOUR_DROPLET_IP:3000
NEXT_ALLOWED_DEV_ORIGINS=